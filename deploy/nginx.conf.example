# Place these locations inside your site's existing HTTPS server block.
# Set TM_COOKIE_SECURE=true in .env, then recreate the app container.
client_max_body_size 512k;

location / {
    proxy_pass http://127.0.0.1:8765;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Replace incoming forwarding headers; do not trust client-provided values.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 180s;
}

# Public /api/public/ requests also have an application IP/global rate limit.
