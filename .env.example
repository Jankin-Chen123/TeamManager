# Run scripts/init_config.py to generate installation-specific values.
TM_MASTER_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
TM_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_INITIAL_PASSWORD
TM_DATABASE_URL=sqlite:///data/teammanager.db
TM_COOKIE_SECURE=false
TM_REQUEST_TIMEOUT=20
TM_CONCURRENCY=4
TM_SESSION_HOURS=12
TM_PUBLIC_REDEMPTION=true
# TM_IMAGE=ghcr.io/OWNER/teammanager:v0.4.0

TM_BACKUP_HOURS=24
TM_BACKUP_KEEP=14
TM_BACKUP_DIR=backups
# Trust only your actual reverse proxy address; never use * on a publicly reachable app.
TM_TRUSTED_PROXIES=127.0.0.1
